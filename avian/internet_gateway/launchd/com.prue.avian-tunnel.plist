<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.prue.avian-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--no-autoupdate</string>
    <string>--loglevel</string>
    <string>info</string>
    <string>--metrics</string>
    <string>127.0.0.1:49312</string>
    <string>run</string>
    <string>--token-file</string>
    <string>/Users/prue/.cloudflared/avian-visitors.token</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/prue/Library/Logs/avian-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/prue/Library/Logs/avian-tunnel.error.log</string>
</dict>
</plist>
